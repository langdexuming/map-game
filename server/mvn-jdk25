#!/usr/bin/env bash
# 使用 JDK 25.0.3 调用 Maven（不依赖全局 JAVA_HOME）
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v /usr/libexec/java_home >/dev/null 2>&1; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 25 2>/dev/null || true)"
fi
if [ -z "${JAVA_HOME:-}" ]; then
  export JAVA_HOME="/Library/Java/JavaVirtualMachines/liberica-jdk-25.jdk/Contents/Home"
fi
export PATH="$JAVA_HOME/bin:$PATH"
exec mvn "$@"
